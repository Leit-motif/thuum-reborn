{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 21,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "common",
			"hidden": true,
			"cacheVariables": {
				"BUILD_TESTS": "OFF",
				"SKSE_SUPPORT_XBYAK": "OFF"
			},
			"binaryDir": "${sourceDir}/build"
		},
		{
			"name": "vcpkg",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": {
					"type": "STRING",
					"value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
				},
				"VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
			}
		},
		{
			"name": "win64",
			"hidden": true,
			"architecture": "x64",
			"cacheVariables": {
				"CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
			}
		},
		{
			"name": "msvc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_FLAGS": "/EHsc /MP /W4 $penv{CXXFLAGS}"
			},
			"generator": "Visual Studio 17 2022",
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-msvc-x64"
				}
			}
		},
		{
			"name": "ALL",
			"displayName": "Skyrim SE 1.5.97 + AE 1.6.1170",
			"cacheVariables": {
				"BUILD_SKYRIM": "ON",
				"ENABLE_SKYRIM_SE": "ON",
				"ENABLE_SKYRIM_AE": "ON",
				"ENABLE_SKYRIM_VR": "OFF"
			},
			"inherits": [
				"common",
				"vcpkg",
				"win64",
				"msvc"
			]
		}
	],
	"buildPresets": [
		{
			"name": "ALL-Release",
			"configurePreset": "ALL",
			"configuration": "Release"
		}
	]
}
